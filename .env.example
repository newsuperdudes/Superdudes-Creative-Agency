VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Cloudflare Worker that writes images to R2.
VITE_UPLOAD_ENDPOINT=https://superdudes-upload.example.workers.dev

# NOTE: there is no VITE_UPLOAD_TOKEN any more. Every VITE_ value is baked
# into the public bundle, so a shared upload token was never a real secret.
# The Worker now authorises each upload with the signed-in editor's own
# access token instead.
